  (administeredItemContext [NASA_PDS])
  (definition [DEF.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.first_sampling_parameter_value])
  (designation [DES.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.first_sampling_parameter_value])
  (sectionLanguage [LI_English]))
([DEF.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.first_sampling_parameter_value] of Definition
  (definitionText "The first_sampling_parameter_value element provides the first value in an ascending series and is therefore the minimum value at which a given data item was sampled.")
  (isPreferred "TRUE"))
([DES.0001_NASA_PDS_1.pds.Uniformly_Sampled.pds.first_sampling_parameter_value] of Designation
  (designationName "first_sampling_parameter_value")
