([vm.0001_NASA_PDS_1.pds.Encoded_Native.pds.encoding_standard_id.281667208] of ValueMeaning
  (beginDate "2009-06-09")
  (containing1 [EVD.0001_NASA_PDS_1.pds.Encoded_Native.pds.encoding_standard_id])
  (endDate "2019-12-31")
  (description "For Malin Space Science Systems %28MSSS%29 cameras such as MSL Mastcam, MAHLI, and MARDI, the first 64 bytes of the transmitted raw data product is known as the mini-header and provides enough information to decompress and use the raw data product. The mini-header is described in section 4.4.3 of the MSL MMM Data Products SIS %28urn:nasa:pds:msl_mmm:document:msl_mmm_dpsis%29."))
 
