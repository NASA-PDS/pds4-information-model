  (containing1 [EVD.0001_NASA_PDS_1.pds.Encoded_Native.pds.encoding_standard_id])
  (endDate "2019-12-31")
  (description "For Malin Space Science Systems %28MSSS%29 cameras such as MSL Mastcam, MAHLI, and MARDI, this is the raw, compressed data product as transmitted from the spacecraft. The format is described in urn:nasa:pds:msl_mmm:document:msss_odr_format and urn:nasa:pds:msl_mmm:document:msss_odr_ref_software."))
 
